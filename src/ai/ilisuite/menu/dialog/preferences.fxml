<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import java.lang.*?>
<?import javafx.scene.layout.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="450.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
   <center>
      <VBox spacing="20.0" BorderPane.alignment="CENTER">
         <children>
            <VBox spacing="10.0">
               <children>
                  <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="%general.language.label" />
                  <Separator />
                  <HBox spacing="20.0">
                     <children>
                        <RadioButton fx:id="radio_languageEs" mnemonicParsing="false" text="%general.language.spanish" userData="%general.language.codSpanish">
                           <toggleGroup>
                              <ToggleGroup fx:id="grp_language" />
                           </toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="radio_languageEn" mnemonicParsing="false" text="%general.language.english" toggleGroup="$grp_language" userData="%general.language.codEnglish" />
                        <RadioButton fx:id="radio_languageDe" mnemonicParsing="false" text="%general.language.german" toggleGroup="$grp_language" userData="%general.language.codGerman" />
                     </children>
                     <padding>
                        <Insets left="10.0" />
                     </padding>
                  </HBox>
               </children>
            </VBox>
            
            <VBox spacing="10.0">
               <children>
                  <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="%validateData.logging" />
                  <Separator />
                  <VBox spacing="8.0">
                     <children>
                        <CheckBox fx:id="chk_traceEnable" mnemonicParsing="false" text="%validateData.logging.traceEnabled" />
                        <CheckBox fx:id="chk_logEnabled" mnemonicParsing="false" onAction="#onAction_chk_logEnabled" text="%validateData.logging.logEnabled" />
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label text="%dialog.preferences.logDirLable" />
                              <TextField fx:id="txt_logDirPath" editable="false" prefWidth="300.0" HBox.hgrow="ALWAYS" />
                              <Button fx:id="btn_logDirBrowse" mnemonicParsing="false" onAction="#onClick_btn_logDirBrowse" text="%buttons.browse" />
                           </children>
                           <padding>
                              <Insets left="25.0" />
                           </padding>
                        </HBox>
                     </children>
                     <padding>
                        <Insets left="10.0" />
                     </padding>
                  </VBox>
               </children>
            </VBox>
            
            <VBox spacing="10.0">
               <children>
                  <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="%dialog.preferences.maxMemoryLabel" />
                  <Separator />
                  <VBox spacing="8.0">
                     <children>
                        <CheckBox fx:id="chk_maxMemoryEnabled" mnemonicParsing="false" onAction="#onAction_chk_maxMemoryEnabled" text="%dialog.preferences.maxMemoryEnabled" />
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label fx:id="lbl_maxMemory" text="%dialog.preferences.maxMemoryLabel" />
                              <Label fx:id="lbl_maxMemoryValue" style="-fx-font-weight: bold;" text="0 MB" />
                           </children>
                           <padding>
                              <Insets left="25.0" />
                           </padding>
                        </HBox>
                        <Slider fx:id="slider_maxMemory" blockIncrement="100.0" majorTickUnit="1000.0" max="8000.0" min="100.0" minorTickCount="9" showTickLabels="true" showTickMarks="true" snapToTicks="true">
                           <padding>
                              <Insets left="25.0" />
                           </padding>
                        </Slider>
                     </children>
                     <padding>
                        <Insets left="10.0" />
                     </padding>
                  </VBox>
               </children>
            </VBox>
         </children>
         <padding>
            <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>
